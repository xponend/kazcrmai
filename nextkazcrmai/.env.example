# Required
PORT=3000
NODE_ENV=development
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Optional — if unset, uses an in-memory mongodb-memory-server (dev/demo only)
MONGODB_URI=

# Optional — required for AI ticket classification/prioritization/routing
GROQ_API_KEY=

# Token lifetimes
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Comma-separated origin allowlist for CORS. Leave empty to allow all (dev).
ALLOWED_ORIGINS=

# Set to "true" to seed demo data on boot when DB is empty.
SEED_ON_BOOT=false
