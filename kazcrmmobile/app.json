{
  "expo": {
    "name": "KazCRM AI",
    "slug": "kazcrmmobile",
    "owner": "sultandelux",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kazcrmmobile",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kz.kazcrmai.mobile"
    },
    "android": {
      "package": "kz.kazcrmai.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F1ECE0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#F1ECE0",
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db280bc1-ad39-4958-8ec1-cb8096a316da"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/db280bc1-ad39-4958-8ec1-cb8096a316da"
    }
  }
}
